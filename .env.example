# Air4 Master Plan — environment template.
#
# Copy to .env.local and fill in. NEVER commit .env.local, a service-account
# JSON file, a private key or a token: .gitignore already excludes .env*.local,
# and nothing in this file should ever hold a real secret.

# ---------------------------------------------------------------------------
# Database (required in production)
# ---------------------------------------------------------------------------
# Turso / libSQL. Vercel's filesystem is read-only and discarded on every
# deploy, so the working copy — connection reviews, progress, layout, audit
# history — has to live off-box.
#
#   npm i -g turso
#   turso db create cute-master-plan
#   turso db show cute-master-plan --url
#   turso db tokens create cute-master-plan
#
# Leave BOTH unset for local development and the test suite: the app then falls
# back to file:data/air4.db through the same driver, so local and production run
# identical code.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Session signing (required)
# ---------------------------------------------------------------------------
# Generated automatically by `npm run seed` on first setup. Changing it signs
# every existing session out.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Google Sheet source (required for sync)
# ---------------------------------------------------------------------------
# The company project sheet. Defaults are compiled in, so these three only need
# setting to point at a different sheet or tab.
GOOGLE_SPREADSHEET_ID=1zby_FYFWKHXDLP5Q6Z74XD3A7Onpxvs7zsuuV-5kc-0
GOOGLE_SHEET_TAB=สรุปโปรเจค
GOOGLE_SHEET_GID=1327666860

# ---------------------------------------------------------------------------
# Google authentication — pick ONE
# ---------------------------------------------------------------------------

# (a) Service account — recommended.
#     Google Cloud console → IAM → Service Accounts → create → Keys → add key
#     (JSON). Enable the Google Sheets API on the project. Then share the
#     spreadsheet with the service-account address as a Viewer; read-only access
#     is all the app asks for.
#     Paste the private_key value exactly as it appears in the JSON, including
#     the BEGIN/END lines, wrapped in double quotes on one line with \n escapes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=air4-sheet-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"

# (b) API key — only works if the sheet is shared "anyone with the link can
#     view". Simpler, but the sheet is then public to anyone holding the link.
# GOOGLE_SHEETS_API_KEY=

# (c) Local fixture — no network, no credentials. Reads a .tsv or .json snapshot
#     instead of Google, for offline development and for the sync test suite.
#     Takes precedence over (a) and (b) when set, so leave it unset in normal use.
# AIR4_SHEET_FIXTURE=data/fixtures/sheet-current.tsv

# ---------------------------------------------------------------------------
# Scheduled sync (required in production)
# ---------------------------------------------------------------------------
# Shared secret for POST /api/sync/google-sheet/auto, which the daily 08:30
# Asia/Bangkok GitHub Actions workflow calls. Generate a long random value.
# The same value must be set as a GitHub repository secret, alongside
# PRODUCTION_URL. If it is unset the endpoint refuses to run at all.
SYNC_CRON_SECRET=

# ---------------------------------------------------------------------------
# Seeding (first setup only)
# ---------------------------------------------------------------------------
# Initial admin password, read by scripts/seed.mjs. Unset it afterwards.
# AIR4_ADMIN_PASSWORD=
